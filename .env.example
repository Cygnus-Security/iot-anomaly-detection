# Copy to .env and replace every CHANGE_ME value, or run scripts/bootstrap_env.sh.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_HOST_PORT=1883
DASHBOARD_PORT=8501
MQTT_KEEPALIVE=30

# Broker roles. Do not reuse these example values outside an isolated lab.
DEVICE_PASSWORD=CHANGE_ME_DEVICE_PASSWORD
COLLECTOR_PASSWORD=CHANGE_ME_COLLECTOR_PASSWORD
OPERATOR_PASSWORD=CHANGE_ME_OPERATOR_PASSWORD

DEVICE_COUNT=12
DEVICE_BASE_INTERVAL_SECONDS=5.0
DEVICE_INTERVAL_JITTER_SECONDS=0.5
DEVICE_INITIAL_SPREAD_SECONDS=5.0
DEVICE_HEARTBEAT_SECONDS=30.0
SIMULATION_SEED=20261108

SQLITE_PATH=/app/data/runtime/iot_anomaly.db
COLLECTOR_QUEUE_SIZE=10000
COLLECTOR_MAX_PAYLOAD_BYTES=4096
LOG_LEVEL=INFO
